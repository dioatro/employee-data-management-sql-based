# ==============================================================================
# Database Configuration
# ==============================================================================
# Set DB_BACKEND to "mysql", "sqlite", or "auto"
# "auto" will attempt to connect to MySQL first, and gracefully fall back to SQLite
DB_BACKEND=auto

# MySQL Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=project
MYSQL_DATABASE=Employee_Data_Management

# SQLite Path (used when DB_BACKEND=sqlite or during MySQL fallback)
SQLITE_PATH=employee_data.db

# ==============================================================================
# Web Application Configuration
# ==============================================================================
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
